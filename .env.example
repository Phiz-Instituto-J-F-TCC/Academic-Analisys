# ── Phiz Credentials ────────────────────────────────────────
PHIZ_APP_ID=your_app_id_here
PHIZ_APP_SECRET=your_app_secret_here
PHIZ_CHANNEL_ID=your_channel_id_here

# ── Webhook Verification Tokens (you define these, 8-100 chars) ──
VERIFY_TOKEN_STATUSES=your_verify_token_statuses_here
VERIFY_TOKEN_MESSAGES=your_verify_token_messages_here

# ── Webhook Secrets (returned by Phiz after set_webhooks) ───
WEBHOOK_SECRET_STATUSES=whs_xxx
WEBHOOK_SECRET_MESSAGES=whs_xxx

# ── Phiz API Base URL ──────────────────────────────────────
PHIZ_API_BASE=https://api-test.phiz.live

# ── OpenAI Token ────────────────────────────────────────────
OPENAI_API_KEY=your_ai_token_here
